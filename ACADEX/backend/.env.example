# ==============================================================================
# ACADEX Backend — Environment Variables Configuration (.env.example)
# Copy this file to .env and provide your production credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Security
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DJANGO_DEBUG=False

# Allowed Hostnames (comma-separated, e.g. your backend domain)
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,acadex-backend.up.railway.app,localhost,127.0.0.1

# Production Database (PostgreSQL URL e.g. Supabase, Neon, Railway, AWS RDS)
# If omitted or left blank, backend falls back to local SQLite database (db.sqlite3)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# CORS / Allowed Frontend Origins (comma-separated, e.g. your Vercel deployment URL)
CORS_ALLOWED_ORIGINS=https://acadex.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# SSL / HTTPS Redirect (Enable in production with active SSL certificate)
SECURE_SSL_REDIRECT=True

# Demo Account Password (Optional: override default demo user password for seed_data.py)
DEMO_USER_PASSWORD=ChangeThisPasswordInProduction!
