{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://acadex-backend-2n0i.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://acadex-backend-2n0i.onrender.com/media/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/ACADEX/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/ACADEX/frontend/js/:path*"
    },
    {
      "source": "/((?!api|media|css|js).*)",
      "destination": "/ACADEX/frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
