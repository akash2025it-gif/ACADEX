{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://acadex-backend-2n0i.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://acadex-backend-2n0i.onrender.com/api/"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://acadex-backend-2n0i.onrender.com/media/$1"
    },
    {
      "source": "/media",
      "destination": "https://acadex-backend-2n0i.onrender.com/media/"
    },
    {
      "source": "/css/(.*)",
      "destination": "/ACADEX/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/ACADEX/frontend/js/$1"
    },
    {
      "source": "/((?!api|media|css|js).*)",
      "destination": "/ACADEX/frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
